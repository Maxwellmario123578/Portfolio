{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "portfoliomathurin.vercel.app" }],
      "destination": "https://masewellmathurin.fr/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.masewellmathurin.fr" }],
      "destination": "https://masewellmathurin.fr/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
